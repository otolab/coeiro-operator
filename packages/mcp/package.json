{
  "name": "@coeiro-operator/mcp",
  "version": "1.6.0",
  "description": "MCP server for COEIRO Operator",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "bin": {
    "coeiro-operator": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/copy-mcp-assets.mjs",
    "start": "node dist/server.js",
    "test": "vitest --root ../.. --config vitest.config.ts --silent=true packages/mcp/src",
    "test:watch": "vitest --watch --root ../.. --config vitest.config.ts packages/mcp/src",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@coeiro-operator/audio": "workspace:*",
    "@coeiro-operator/common": "workspace:*",
    "@coeiro-operator/core": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "14.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.18.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "keywords": [
    "mcp",
    "server",
    "coeiroink"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otolab/coeiro-operator.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/otolab/coeiro-operator#readme",
  "bugs": {
    "url": "https://github.com/otolab/coeiro-operator/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
